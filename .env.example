# Copy this file to .env.local and fill in your own keys.
# .env.local is listed in .gitignore and will never be uploaded.
AMAP_WEB_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Amap "Web end (JS API)" key for the interactive map. It is public by design (it ships to the browser):
# protect it with a domain whitelist in the Amap console. Use a DIFFERENT key from AMAP_WEB_KEY.
# Local dev must use http://127.0.0.1:3000 because Amap does not accept "localhost" in the whitelist.
NEXT_PUBLIC_AMAP_JS_KEY=

# Random string used to sign statistics (required in production).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=

# Optional rate limits (defaults shown). Limits are off in `npm run dev` unless RATE_LIMIT_IN_DEV=1.
# RATE_PER_MINUTE=6
# RATE_PER_DAY=30
# RATE_GLOBAL_PER_DAY=300
